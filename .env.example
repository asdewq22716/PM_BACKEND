NODE_ENV=development
PORT=4722

# ==========================================
# 🗄️ Database Configuration (Switchable)
# ==========================================
# Options: 'postgres' | 'mysql'
DB_TYPE=postgres

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pm_db
DB_SSL=false

# ==========================================
# 🔐 JWT Security Configuration
# ==========================================
JWT_SECRET=pm_backend_super_secret_key_change_in_production
JWT_EXPIRES_IN=1d
