NODE_ENV=development
PORT=4722

# ==========================================
# 🗄️ Database Configuration (Switchable)
# ==========================================
# Options: 'postgres' | 'mysql'
DB_TYPE=postgres

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pm_db
DB_SSL=false

# ==========================================
# 🔐 JWT Security Configuration
# ==========================================
JWT_SECRET=pm_backend_super_secret_key_change_in_production
JWT_EXPIRES_IN=1d

# ==========================================
# 📧 SMTP / Mail Configuration (Optional - Defaults to Simulation Mode)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="PM Notification" <no-reply@pm-system.com>

